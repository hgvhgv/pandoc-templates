#let content-to-string(content) = {
  if content.has("text") {
    content.text
  } else if content.has("children") {
    content.children.map(content-to-string).join("")
  } else if content.has("body") {
    content-to-string(content.body)
  } else if content == [ ] {
    " "
  }
}
#let conf(
  title: none,
  subtitle: none,
  authors: (),
  keywords: (),
  date: none,
  abstract-title: none,
  abstract: none,
  extratitle1: none,
  extratitle2: none,
  spacing: 1,
  first-line-indent: 0.5in,
  header: false,
  footer: false,
  titleblock: false,
  thanks: none,
  cols: 1,
  margin: (x: 1.15in, y: 1in),
  paper: "us-letter",
  lang: "en",
  region: "US",
  font: ("EB Garamond", "Times New Roman"),
  fontsize: 12pt,
  mathfont: none,
  codefont: none,
  linestretch: 1,
  sectionnumbering: none,
  linkcolor: none,
  citecolor: none,
  filecolor: none,
  pagenumbering: "1",
  letter: none,
  recipient: (),
  salutation: none,
  signoff: none,
  doc,
) = {
  set document(
    title: title,
    keywords: keywords,
  )
  set document(
      author: authors.map(author => content-to-string(author.name)).join(", ", last: " & "),
  ) if authors != none and authors != ()
  set page(
    paper: paper,
    margin: margin,
    numbering: pagenumbering,
    columns: cols,
    header: if header { context {
      if counter(page).get().first() > 1 {
        let author-last = if authors.len() > 0 {
          let author-name = content-to-string(authors.at(0).name)
          author-name.split(" ").last()
        } else { "" }
        let title-short = if title != none { content-to-string(title) } else { "" }
        let date-str = if date != none { content-to-string(date) } else { "" }
        
        let header-parts = ()
        if author-last != "" { header-parts.push(author-last) }
        if title-short != "" { header-parts.push(title-short) }
        if date-str != "" { header-parts.push(date-str) }
        
        align(left)[#header-parts.join(" / ")]
      }
    } } else { none },
    footer: if footer { context {
      let page-num = counter(page).get().first()
      let total-pages = counter(page).final().first()
      align(right)[#page-num / #total-pages]
    } } else { none },
    )
  set par(justify: false, first-line-indent: first-line-indent, leading: (linestretch * 0.65em), spacing: (spacing * 0.65em))
  set text(lang: lang,
           region: region,
           font: font,
           size: fontsize)

  show math.equation: set text(font: mathfont) if mathfont != none
  show raw: set text(font: codefont) if codefont != none

  set heading(numbering: sectionnumbering)
  
  show heading.where(level: 1): it => block(above: 1em, below: 1em)[
    #set par(first-line-indent: 0pt)
    #set text(weight: "bold", size: fontsize)
    #it.body
  ]
  
  show heading.where(level: 2): it => block(above: 1em, below: 1em)[
    #set par(first-line-indent: 0pt)
    #set text(style: "italic", weight: "bold", size: fontsize)
    #it.body
  ]
  
  show heading.where(level: 3): it => block(above: 1em, below: 1em)[
    #set par(first-line-indent: 0pt)
    #set text(style: "italic", size: fontsize)
    #it.body
  ]

  show heading.where(level: 4): it => block(above: 1em, below: 1em)[
    #set par(first-line-indent: 0pt)
    #set text(weight: "regular", size: fontsize)
    #it.body
  ]

  if titleblock and (title != none or authors.len() > 0 or date != none) {
    let author = if authors.len() > 0 { authors.at(0).name } else { none }
    let title-text = if title != none { content-to-string(title) } else { "" }
    let subtitle-text = if subtitle != none { content-to-string(subtitle) } else { "" }
    let full-title = if subtitle-text != "" { title-text + ": " + subtitle-text } else { title-text }
    
    block(below: 1em, breakable: false)[
      #if author != none [ #author ]
      #if full-title != "" [ \ #full-title ]
      #if extratitle1 != none [ \ #extratitle1 ]
      #if extratitle2 != none [ \ #extratitle2 ]
      #if date != none [ \ #date ]
    ]
  }
  if letter != none and letter {
    let author = if authors != none and authors != () { authors.at(0) } else { none }
    let recip = if recipient != none and recipient != () { recipient.at(0) } else { none }

    set par(first-line-indent: 0pt)

    if author != none [
      #author.name
      #if author.address != none and author.address != [] [\ #author.address]
      #if ((author.email != none and author.email != []) or (author.phone != none and author.phone != [])) {
        v(.25em)
        }
      #if author.email != none and author.email != [] [#author.email ]
      #if author.phone != none and author.phone != [] [| #author.phone]
    ]

    v(.65em)

    if recip != none [
      #recip.name
      #if recip.address != none [\ #recip.address]
      #if ((recip.email != none and recip.email != []) or (recip.phone != none and recip.phone != [])) {
        v(.65em)
        }
      #if recip.email != none and recip.email != [] [#recip.email \ ]
      #if recip.phone != none and recip.phone != [] [#recip.phone]
    ]

    v(.65em)

    if date != none [#date]

    v(.65em)

    let salutation-text = if salutation != none {
      salutation
    } else if recip != none {
      [Dear #recip.name,]
    } else {
      none
    }
    if salutation-text != none [#salutation-text]

    v(.65em)

    set par(first-line-indent: first-line-indent)

    doc

    v(.65em)

    let signoff-text = if signoff != none { signoff } else { [Sincerely yours,] }
    signoff-text

    v(.65em)

    if author != none [#author.name]
  } else {
    doc
  }
}
