#let content-to-string(content) = {
  if content.has("text") {
    content.text
  } else if content.has("children") {
    content.children.map(content-to-string).join("")
  } else if content.has("body") {
    content-to-string(content.body)
  } else if content == [ ] {
    " "
  }
}
#let conf(
  title: none,
  subtitle: none,
  authors: (),
  keywords: (),
  date: none,
  abstract: none,
  extratitle1: none,
  extratitle2: none,
  spacing: 1,
  header: true,
  footer: true,
  titleblock: true,
  cols: 1,
  margin: (x: 1in, y: 1in),
  paper: "us-letter",
  lang: "en",
  region: "US",
  font: ("EB Garamond", "Times New Roman"),
  fontsize: 12pt,
  sectionnumbering: none,
  pagenumbering: "1",
  doc,
) = {
  set document(
    title: title,
    author: authors.map(author => content-to-string(author.name)),
    keywords: keywords,
  )
  set page(
    paper: paper,
    margin: margin,
    numbering: pagenumbering,
    columns: cols,
    header: if header { context {
      if counter(page).get().first() > 1 {
        let author-last = if authors.len() > 0 {
          let author-name = content-to-string(authors.at(0).name)
          author-name.split(" ").last()
        } else { "" }
        let title-short = if title != none { content-to-string(title) } else { "" }
        let date-str = if date != none { content-to-string(date) } else { "" }
        
        let header-parts = ()
        if author-last != "" { header-parts.push(author-last) }
        if title-short != "" { header-parts.push(title-short) }
        if date-str != "" { header-parts.push(date-str) }
        
        align(left)[#header-parts.join(" / ")]
      }
    } } else { none },
    footer: if footer { context {
      let page-num = counter(page).get().first()
      let total-pages = counter(page).final().first()
      align(right)[#page-num / #total-pages]
    } } else { none },
    )
  set par(justify: false, first-line-indent: 0.5in, leading: (spacing * 0.65em), spacing: (spacing * 0.65em))
  set text(lang: lang,
           region: region,
           font: font,
           size: fontsize)
  set heading(numbering: sectionnumbering)
  
  show heading.where(level: 1): it => block(above: 1em, below: 1em)[
    #set par(first-line-indent: 0pt)
    #set text(weight: "bold", size: fontsize)
    #it.body
  ]
  
  show heading.where(level: 2): it => block(above: 1em, below: 1em)[
    #set par(first-line-indent: 0pt)
    #set text(style: "italic", weight: "regular", size: fontsize)
    #it.body
  ]
  
  show heading.where(level: 3): it => block(above: 1em, below: 1em)[
    #set par(first-line-indent: 0pt)
    #set text(weight: "regular", size: fontsize)
    #it.body
  ]

  if titleblock and (title != none or authors.len() > 0 or date != none) {
    let author = if authors.len() > 0 { authors.at(0).name } else { none }
    let title-text = if title != none { content-to-string(title) } else { "" }
    let subtitle-text = if subtitle != none { content-to-string(subtitle) } else { "" }
    let full-title = if subtitle-text != "" { title-text + ": " + subtitle-text } else { title-text }
    let extra-title = if extratitle1 != none { extratitle1 } else { none }
    let extra-title2 = if extratitle2 != none { extratitle2 } else { none }
    
    block(below: 1em, breakable: false)[
      #if author != none [ #author ]
      #if full-title != "" [ \ #full-title ]
      #if extra-title != none [ \ #extra-title ]
      #if extra-title2 != none [ \ #extra-title2 ]
      #if date != none [ \ #date ]
    ]
  }

  doc
}
